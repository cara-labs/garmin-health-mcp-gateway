# Non-secret deployment settings. Copy to .env and adjust for your Docker host.
TZ=America/Los_Angeles

# Numeric owner of the secret files and application data on this host.
# Confirm with: id -u && id -g
GATEWAY_UID=1000
GATEWAY_GID=1000

GARMIN_DAILY_BACKFILL_DAYS=90
GARMIN_ACTIVITY_BACKFILL_DAYS=365
GARMIN_RECENT_DAYS=3
GARMIN_SYNC_INTERVAL_SECONDS=3600
GARMIN_REQUEST_DELAY_SECONDS=1.25
LOG_LEVEL=INFO

# Optional: discloses sampled route coordinates/times to Open-Meteo's non-commercial API.
# ERA5 historical coverage is hourly/~25 km with a five-day delay, not personal exposure.
GARMIN_HISTORICAL_WEATHER=false
WEATHER_REQUEST_TIMEOUT_SECONDS=10
WEATHER_REQUEST_DELAY_SECONDS=2
WEATHER_BATCH_SIZE=1

# Versioned application image published for both arm64 and amd64.
GARMIN_GATEWAY_IMAGE=ghcr.io/cara-labs/garmin-health-mcp-gateway:1.1.0

# Secure MCP Tunnel. Create these in OpenAI Platform tunnel settings.
# Store the API key in secrets/openai_tunnel_api_key.txt, not here.
OPENAI_TUNNEL_ID=tunnel_replace_me
TUNNEL_CLIENT_IMAGE=ghcr.io/openai/tunnel-client:v0.0.13
